{
  "manifest_version": 3,
  "name": "Arcade VR Integration Lab",
  "version": "0.7.0",
  "description": "Outside controls and a live player-head camera for the Arcade hackathon lab. No account tokens are read.",
  "host_permissions": [
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tryarcade.com/*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.tryarcade.com/*",
        "https://editor.joinarcade.ai/*",
        "https://dashboard.joinarcade.ai/*",
        "http://localhost/*"
      ],
      "js": [
        "adapter.js",
        "arena.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tryarcade.com/*",
        "https://editor.joinarcade.ai/*",
        "https://dashboard.joinarcade.ai/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
